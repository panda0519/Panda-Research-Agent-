# Anthropic API Key (Required for core agents and Claude web search)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily API Key (Required for multi-engine search via Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (Optional for Gemini search grounding & dual-model verification)
GEMINI_API_KEY=your_gemini_api_key_here

# Voyage AI API Key (Optional for cross-run vector memory; falls back to offline storage)
VOYAGE_API_KEY=your_voyage_api_key_here

# --- 5 Real-World Data Verification Specializations (All Optional) ---

# 1. Repo Health (TechStackAgent)
# GitHub Token (Optional; unauthenticated requests allow up to 60 req/hr)
GITHUB_TOKEN=your_github_token_here

# 2. Academic Full Text (PaperReaderAgent)
# Unpaywall Email (Optional non-secret email for Open Access PDF resolution)
UNPAYWALL_EMAIL=researcher@example.com
# CORE API Key (Optional for global open access research repository search)
CORE_API_KEY=your_core_api_key_here

# 3. Second-Model Claim Check (Layer 2 Verification)
# Groq API Key (Optional for secondary LLM claim verification; falls back to Gemini)
GROQ_API_KEY=your_groq_api_key_here

# 4. Broader Academic Search (SurveyorAgent & GapAnalystAgent)
# OpenAlex API Key (Optional for high-throughput scholarly graph search)
OPENALEX_API_KEY=your_openalex_api_key_here
# Crossref Mailto Email (Optional non-secret email for Crossref polite pool)
CROSSREF_MAILTO=researcher@example.com

# 5. Computational Claim Check (Layer 2/3 Verification)
# Wolfram Alpha App ID (Optional for authoritative mathematical queries; 5 calls/run cap)
WOLFRAM_APP_ID=your_wolfram_app_id_here

# --- Typed Decision Layer (TypeSafe Jev) ---
# TypeSafe Jev API Key (Optional for deterministic typed decision making & consensus)
TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_API_URL=https://api.typesafe.ai/v1



